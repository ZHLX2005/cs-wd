<Window x:Class="CsWd.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cs-wd 设置" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF1F1F1F" FontFamily="Segoe UI, Microsoft YaHei UI"
        ShowInTaskbar="False">

    <StackPanel Margin="20,16">

        <TextBlock Text="唤起热键" Foreground="#FFFFFFFF" FontSize="14" FontWeight="SemiBold"/>
        <ComboBox x:Name="HotkeyBox" Margin="0,8,0,0" FontSize="14"
                  Background="#FF2B2B2B" Foreground="#FFE8E8E8"/>
        <TextBlock x:Name="HotkeyHint" Text="" FontSize="12" Foreground="#FF9A9A9A" Margin="0,6,0,0"/>

        <CheckBox x:Name="AutoStartBox" Content="开机自动启动" FontSize="14" Foreground="#FFE8E8E8"
                  Margin="0,18,0,0"/>

        <TextBlock Text="数据与日志" Foreground="#FFFFFFFF" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="OpenLogsBtn" Content="打开日志目录" Click="OpenLogs_Click"
                    Padding="10,5" Background="#FF2B2B2B" Foreground="#FFE8E8E8" BorderBrush="#FF444444"/>
            <Button x:Name="OpenDataBtn" Content="打开数据目录" Click="OpenData_Click"
                    Padding="10,5" Background="#FF2B2B2B" Foreground="#FFE8E8E8" BorderBrush="#FF444444"
                    Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="DataDirText" FontSize="11" Foreground="#FF808080" Margin="0,8,0,0"
                   TextTrimming="CharacterEllipsis"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelBtn" Content="取消" Click="Cancel_Click" Width="88" Padding="0,6"
                    Background="#FF2B2B2B" Foreground="#FFE8E8E8" BorderBrush="#FF444444"/>
            <Button x:Name="SaveBtn" Content="保存" Click="Save_Click" Width="88" Padding="0,6"
                    Background="#FF2563EB" Foreground="#FFFFFFFF" BorderThickness="0" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
