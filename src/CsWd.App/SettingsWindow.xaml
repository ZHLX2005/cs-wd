<ui:FluentWindow x:Class="CsWd.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="cs-wd 设置" Width="540" SizeToContent="Height"
                 WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" ShowInTaskbar="False"
                 FontFamily="Segoe UI, Microsoft YaHei UI">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="cs-wd 设置"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,8,20,18">

                <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <!-- 外观 -->
                <ui:Card Margin="0,14,0,0" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="PaintBrush24" FontSize="22"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="外观" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="深色 / 浅色（PowerToys 同款 Fluent 配色，跟随系统强调色）"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="DarkRb" Content="深色" GroupName="theme" FontSize="13" Margin="0,0,14,0"/>
                            <RadioButton x:Name="LightRb" Content="浅色" GroupName="theme" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- 热键 -->
                <ui:Card Margin="0,10,0,0" Padding="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Keyboard20" FontSize="22"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="唤起热键" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="点击下方输入框后直接按下组合键（需含 Ctrl / Alt / Win），Esc 取消录制"
                                           FontSize="12" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <ui:TextBox x:Name="HotkeyBox" IsReadOnly="True" FontSize="15" Margin="36,10,0,0"
                                 Cursor="Hand" PlaceholderText="未录制（保持现状）"
                                 GotKeyboardFocus="HotkeyBox_GotFocus"
                                 LostKeyboardFocus="HotkeyBox_LostFocus"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        <TextBlock x:Name="HotkeyHint" FontSize="11" Margin="36,6,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:Card>

                <!-- 开机自启 -->
                <ui:Card Margin="0,10,0,0" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Home24" FontSize="22"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="开机自动启动" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="登录后最小化到托盘，随时 Alt+Space（或你设置的热键）唤起"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="AutoStartTgl" Grid.Column="2" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <!-- 数据与日志 -->
                <ui:Card Margin="0,10,0,0" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="22"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock Text="数据与日志" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="DataDirText" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="日志" Appearance="Secondary" Click="OpenLogs_Click" Margin="0,0,8,0"/>
                            <ui:Button Content="数据" Appearance="Secondary" Click="OpenData_Click"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- 底部操作 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <ui:Button Content="取消" Appearance="Secondary" Width="96" Click="Cancel_Click"/>
                    <ui:Button Content="保存" Appearance="Primary" Width="96" Margin="10,0,0,0" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
