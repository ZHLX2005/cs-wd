<Window x:Class="CsWd.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cs-wd 设置" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        ShowInTaskbar="False">

    <StackPanel Margin="22,18">

        <TextBlock Text="唤起热键" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   FontSize="14" FontWeight="SemiBold"/>
        <TextBox x:Name="HotkeyBox" IsReadOnly="True" FontSize="16" Margin="0,8,0,0" Padding="10,8"
                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                 CaretBrush="Transparent" Cursor="Hand"
                 GotKeyboardFocus="HotkeyBox_GotFocus"
                 LostKeyboardFocus="HotkeyBox_LostFocus"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
        <TextBlock x:Name="HotkeyHint" Text="点击输入框后按下想要的组合键（需包含 Ctrl/Alt/Win 修饰），Esc 取消"
                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"
                   TextWrapping="Wrap"/>

        <TextBlock Text="主题" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   FontSize="14" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <RadioButton x:Name="DarkRb" Content="深色（PowerToys Dark）" GroupName="theme"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"
                         Margin="0,0,20,0"/>
            <RadioButton x:Name="LightRb" Content="浅色（PowerToys Light）" GroupName="theme"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13"/>
        </StackPanel>

        <CheckBox x:Name="AutoStartBox" Content="开机自动启动" FontSize="14"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  Margin="0,20,0,0"/>

        <TextBlock Text="数据与日志" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   FontSize="14" FontWeight="SemiBold" Margin="0,20,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="OpenLogsBtn" Content="打开日志目录" Click="OpenLogs_Click"
                    Padding="10,5" FontSize="13"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"/>
            <Button x:Name="OpenDataBtn" Content="打开数据目录" Click="OpenData_Click"
                    Padding="10,5" FontSize="13" Margin="8,0,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        </StackPanel>
        <TextBlock x:Name="DataDirText" FontSize="11"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,8,0,0"
                   TextTrimming="CharacterEllipsis"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelBtn" Content="取消" Click="Cancel_Click" Width="88" Padding="0,6"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"/>
            <Button x:Name="SaveBtn" Content="保存" Click="Save_Click" Width="88" Padding="0,6"
                    Background="{DynamicResource AccentBrush}" Foreground="#FFFFFFFF"
                    BorderThickness="0" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
