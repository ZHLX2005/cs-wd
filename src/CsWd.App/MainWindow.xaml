<Window x:Class="CsWd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cs-wd" Width="720" Height="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Deactivated="Window_Deactivated"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Border Background="#FF1F1F1F" BorderBrush="#FF333333" BorderThickness="1" CornerRadius="8">
        <DockPanel>

            <!-- 搜索框（PowerToys Run 顶部大输入） -->
            <Border DockPanel.Dock="Top" Background="#FF2B2B2B" CornerRadius="8,8,0,0">
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text=" 🔍 " FontSize="16" VerticalAlignment="Center"/>
                    <TextBox x:Name="InputBox" Grid.Column="1" FontSize="20"
                             Background="Transparent" Foreground="#FFFFFFFF"
                             BorderThickness="0" CaretBrush="#FF4CC2FF"
                             VerticalContentAlignment="Center"
                             TextChanged="InputBox_TextChanged"
                             KeyDown="InputBox_KeyDown"/>
                    <TextBlock x:Name="ModeHint" Grid.Column="2" Text="" FontSize="12"
                               Foreground="#FF808080" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 结果列表 -->
            <ListBox x:Name="ResultList" DockPanel.Dock="Top"
                     Background="Transparent" BorderThickness="0"
                     Foreground="#FFE8E8E8" FontSize="14"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="14,8"/>
                        <Setter Property="MinHeight" Value="44"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF3B3B3B"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF333333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" Foreground="#FFFFFFFF" FontSize="14"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="#FF9A9A9A" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 状态栏 -->
            <Border DockPanel.Dock="Bottom" Background="#FF181818" CornerRadius="0,0,8,8">
                <TextBlock x:Name="StatusText" Text="ready" FontSize="12" Foreground="#FF808080"
                           Margin="14,5" TextTrimming="CharacterEllipsis"/>
            </Border>
        </DockPanel>
    </Border>
</Window>
