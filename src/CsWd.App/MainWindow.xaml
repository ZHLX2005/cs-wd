<Window x:Class="CsWd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cs-wd" Width="640" SizeToContent="Height" MaxHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Deactivated="Window_Deactivated"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <!-- 复刻 PowerToys Run：640 宽 + SizeToContent + Fluent token -->
    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8">
        <StackPanel>

            <!-- 搜索区：放大镜 + 输入 + 模式提示（LauncherControl 结构） -->
            <Border Padding="12,10,12,6">
                <Grid MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <Grid Grid.Column="1" Margin="6,0,0,0">
                        <TextBox x:Name="InputBox" FontSize="16" MinHeight="32" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 TextChanged="InputBox_TextChanged"
                                 KeyDown="InputBox_KeyDown"/>
                        <TextBlock x:Name="Placeholder" Text="开始输入…（&gt; 前缀执行命令）" FontSize="16"
                                   Foreground="{DynamicResource TextControlPlaceholderForegroundBrush}"
                                   VerticalAlignment="Center" Margin="1,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <TextBlock x:Name="ModeHint" Grid.Column="2" Text="" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <Rectangle Height="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}"/>

            <!-- 结果列表：MinHeight 44 / 48-* / Auto 三列 / pill 选中条 -->
            <ListBox x:Name="ResultList" Margin="4,4,4,0" MaxHeight="430"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="ResultList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="4" Margin="4,1" Padding="0">
                                        <Grid MinHeight="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Fluent pill：3x18 圆角 2，选中可见 -->
                                            <Rectangle x:Name="Pill" Width="3" Height="18" RadiusX="2" RadiusY="2"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       Margin="2,0,0,0"
                                                       Fill="{DynamicResource ListViewItemPillFillBrush}"
                                                       Visibility="Collapsed"/>

                                            <ContentPresenter Grid.ColumnSpan="2" Margin="0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlAltFillColorQuarternaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 图标格（48 列内 32x32 圆角框） -->
                            <Border Width="32" Height="32" CornerRadius="4"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,6,8,6">
                                <TextBlock Text="{Binding Title}" FontSize="16"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding TagText}" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 状态栏（1px 分隔 + tertiary 小字） -->
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    Margin="0,4,0,0" CornerRadius="0,0,8,8">
                <TextBlock x:Name="StatusText" Text="ready" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="14,6,14,9" TextTrimming="CharacterEllipsis"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
