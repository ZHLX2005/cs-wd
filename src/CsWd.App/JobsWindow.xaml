<ui:FluentWindow x:Class="CsWd.JobsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="cs-wd 后台任务" Width="780" Height="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" ShowInTaskbar="False"
                 FontFamily="Segoe UI, Microsoft YaHei UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="后台任务"/>

        <!-- 工具行 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,4,20,4">
            <ui:Button x:Name="RefreshBtn" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowRotateClockwise24}"
                       Click="Refresh_Click" ToolTip="刷新"/>
            <TextBlock x:Name="StatsText" Text="加载中…" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="自动刷新" VerticalAlignment="Center" Margin="20,0,6,0"
                       FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:ToggleSwitch x:Name="AutoRefreshTgl" IsChecked="True"/>
        </StackPanel>

        <!-- 任务列表 -->
        <ScrollViewer Grid.Row="2" Margin="20,8,20,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="JobList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Cmd}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding StatusBrush}"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding MetaText}" FontSize="12" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="日志" Appearance="Secondary" Click="Log_Click" Margin="0,0,8,0"
                                               ToolTip="查看该任务的控制台输出"/>
                                    <ui:Button Content="{Binding KillLabel}" Click="Kill_Click"
                                               Appearance="{Binding KillAppearance}"
                                               ToolTip="结束进程树（taskkill /T /F）"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 状态栏 -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <TextBlock x:Name="StatusText" Text="ready" FontSize="12" Margin="20,6,20,9"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</ui:FluentWindow>
