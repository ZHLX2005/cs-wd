<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- cs-wd Dark 主题 —— 取自 WPF-UI (Fluent) Dark token，与 PowerToys Run 同源 -->

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF202020"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundBrush" Color="#87FFFFFF"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#19000000"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="#12FFFFFF"/>
    <!-- 系统强调色（Fluent 默认）-->
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="#FF60CDFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF60CDFF"/>
</ResourceDictionary>
