<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- cs-wd Light 主题 —— 取自 WPF-UI (Fluent) Light token，与 PowerToys Run 同源 -->

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundBrush" Color="#72000000"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06000000"/>
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="#18000000"/>
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="#FF005FB8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF005FB8"/>
</ResourceDictionary>
